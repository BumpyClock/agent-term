<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>../../src/AgentTerm.App/app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <TerminalSurfaceSource Condition="'$(TerminalSurfaceSource)' == ''">$(MSBuildThisFileDirectory)../../src/AgentTerm.App/TerminalSurface.cs</TerminalSurfaceSource>
    <TerminalSurfaceScrollingSource>$([System.IO.Path]::GetDirectoryName('$(TerminalSurfaceSource)'))/TerminalSurface.Scrolling.cs</TerminalSurfaceScrollingSource>
    <TerminalProject Condition="'$(TerminalProject)' == ''">$(MSBuildThisFileDirectory)../../src/AgentTerm.Terminal/AgentTerm.Terminal.csproj</TerminalProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <ProjectReference Include="$(TerminalProject)" />
    <Compile Include="$(TerminalSurfaceSource)" Link="TerminalSurface.cs" />
    <Compile Include="$(TerminalSurfaceScrollingSource)" Link="TerminalSurface.Scrolling.cs" Condition="Exists('$(TerminalSurfaceScrollingSource)')" />
  </ItemGroup>
</Project>
