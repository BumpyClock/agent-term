<Page
    x:Class="AgentTerm_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentTerm_App"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Padding="8" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="SessionHeader" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ShellText" Text="PowerShell" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="StopButton" Content="Stop session" Click="Stop_Click" IsEnabled="False" ToolTipService.ToolTip="Stop this shell session" />
                <Button x:Name="NewSessionButton" Content="New session" Click="NewSession_Click" IsEnabled="False" ToolTipService.ToolTip="Start a new session with this shell profile" />
            </StackPanel>
        </Grid>
        <!-- Pane header controls. Attached to the pane header on load, so a status change never changes the terminal height or the PTY size. -->
        <Grid Grid.Row="0">
                <StackPanel x:Name="PromptModeControls" Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="PromptModeStatus" Style="{StaticResource AgentHintText}" VerticalAlignment="Center" MaxWidth="220"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="TaskStatusButton" Style="{StaticResource AgentQuietButtonStyle}" FontSize="12" Padding="6,0" MinHeight="22" Visibility="Collapsed"
                            Click="TaskStatus_Click" ToolTipService.ToolTip="Open the agent task (Ctrl+Shift+Y)" AutomationProperties.AcceleratorKey="Control+Shift+Y">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="TaskStatusIcon" Glyph="&#xE99A;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <Grid x:Name="TaskStatusLabelHost" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InteractButton" Style="{StaticResource AgentQuietButtonStyle}" FontSize="12" Padding="6,0" MinHeight="22" Visibility="Collapsed"
                            Content="Type into command" Click="Interact_Click" AutomationProperties.Name="Type into the agent's running command"
                            ToolTipService.ToolTip="Send your keystrokes to the command the agent is running, for example to answer Read-Host. Until you choose this, typing does not reach it. Agent replies stay paused until the turn finishes." />
                    <Button x:Name="RawTerminalButton" FontSize="12" Padding="8,2" MinHeight="24" Click="RawTerminal_Click" AutomationProperties.Name="Switch display mode" />
                </StackPanel>
        </Grid>
        <InfoBar x:Name="ErrorBanner" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" Title="Shell session unavailable" />
        <Grid Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="FindBar" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="3" RowSpacing="2" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid.Resources>
                    <Style x:Key="FindActionButton" TargetType="Button">
                        <Setter Property="Width" Value="30" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </Grid.Resources>
                <TextBox x:Name="FindBox" MinWidth="0" PlaceholderText="Find" TextChanged="FindBox_TextChanged"
                         KeyDown="FindBox_KeyDown" AutomationProperties.Name="Find in terminal" />
                <Button Grid.Column="1" Style="{StaticResource FindActionButton}" Click="FindPrevious_Click"
                        AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match (Shift+Enter)">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource FindActionButton}" Click="FindNext_Click"
                        AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match (Enter)">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource FindActionButton}" Click="FindClose_Click"
                        AutomationProperties.Name="Close search" ToolTipService.ToolTip="Close search (Escape)">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox x:Name="FindMatchCase" MinWidth="0" Content="Match case" Checked="FindMatchCase_Changed"
                              Unchecked="FindMatchCase_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="FindStatus" Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Grid>
            <local:TerminalSurface Grid.Row="1" x:Name="Terminal" MinHeight="0" SizeChanged="Output_SizeChanged"
             PreviewKeyDown="Terminal_KeyDown" GotFocus="Terminal_GotFocus" LostFocus="Terminal_LostFocus"
             AutomationProperties.Name="Terminal" AutomationProperties.HelpText="Drag to select. Ctrl+Shift+C copies selection. Ctrl+Shift+V pastes. Ctrl+Shift+Tab switches to the previous tab." />
            <!-- Agent task cards sit on two blank history rows reserved at invocation and scroll with that history. -->
            <Canvas x:Name="TaskCardLayer" Grid.Row="1" SizeChanged="TaskCardLayer_SizeChanged"
                    PointerWheelChanged="TaskCardLayer_PointerWheelChanged" AutomationProperties.Name="Agent tasks in terminal history" />
            <ScrollBar x:Name="HistoryScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="0"
                       ValueChanged="HistoryScrollBar_ValueChanged" AutomationProperties.Name="Terminal scrollback" />
        </Grid>
        <!-- The agent surface replaces the terminal view in place. The shell keeps running underneath at the same size. -->
        <Grid x:Name="AgentSurface" Grid.Row="2" Visibility="Collapsed" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="32">
                <Button x:Name="LeaveSurfaceButton" Style="{StaticResource AgentQuietButtonStyle}" Padding="6,2" Click="LeaveSurface_Click"
                        AutomationProperties.Name="Back to terminal">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <Border Style="{StaticResource AgentKeyChip}"><TextBlock Text="Esc" FontSize="11" /></Border>
                        <TextBlock Text="for terminal" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SurfaceTitle" Grid.Column="1" Style="{StaticResource AgentCommandText}" TextTrimming="CharacterEllipsis" TextAlignment="Left" AutomationProperties.HeadingLevel="Level1" />
                </Grid>
                <Button x:Name="StopAgentButton" Grid.Column="2" Style="{StaticResource AgentQuietButtonStyle}" Padding="8,2" Click="InterruptAgent_Click"
                        Opacity="0" IsEnabled="False" AutomationProperties.Name="Stop the agent" ToolTipService.ToolTip="Stop the agent's current turn (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73B;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                        <Border x:Name="StopShortcut" Style="{StaticResource AgentKeyChip}"><TextBlock Text="Ctrl+C" FontSize="11" /></Border>
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer x:Name="AgentOutput" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="4,0,16,0">
                <Grid x:Name="AgentTimelineHost" VerticalAlignment="Bottom" />
            </ScrollViewer>
            <!-- Approvals and questions sit where the next action happens: directly above the input. -->
            <local:AgentRequestPanel x:Name="RequestPanel" Grid.Row="2" Visibility="Collapsed" />
            <!-- The agent reply field exists only inside the agent surface. Shell commands and /agent are typed at the shell's own prompt. -->
            <Grid x:Name="ReplyArea" Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="2" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinHeight="32">
                    <TextBlock x:Name="PromptGlyph" Text="&#x2726;" Style="{StaticResource AgentPromptGlyphAgent}" Margin="2,5,0,0"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBox x:Name="AgentReply" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="0" MaxHeight="132" Padding="0,4,0,4"
                             FontSize="14" Background="Transparent" BorderThickness="0" IsSpellCheckEnabled="False"
                             TextChanged="AgentReply_Changed" PreviewKeyDown="AgentReply_KeyDown" GotFocus="AgentReply_FocusChanged" LostFocus="AgentReply_FocusChanged"
                             AutomationProperties.Name="Reply to the agent" TextCompositionStarted="AgentReply_CompositionStarted" TextCompositionEnded="AgentReply_CompositionEnded">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="SubmitPrompt" Grid.Column="2" Style="{StaticResource AgentIconButtonStyle}" VerticalAlignment="Top" Click="SubmitPrompt_Click"
                            AutomationProperties.Name="Send" ToolTipService.ToolTip="Send (Enter)">
                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                    </Button>
                </Grid>
                <TextBlock x:Name="PromptHint" Grid.Row="1" Style="{StaticResource AgentHintText}" Margin="22,0,0,2" Height="22" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>
        <Grid x:Name="SessionFooter" Grid.Row="3" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Starting session..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="GridSizeText" Grid.Column="1" Text="80 × 24" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
