<UserControl
    x:Class="AgentTerm_App.TerminalPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Loaded="Pane_Loaded" Unloaded="Pane_Unloaded">
    <Grid Background="Transparent" Translation="0,0,8">
        <Grid.Shadow><ThemeShadow /></Grid.Shadow>
        <Border x:Name="SolidSurface" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
        <Border x:Name="AcrylicSurface" CornerRadius="10" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed" />
        <Grid Margin="1" RowDefinitions="32,*">
            <Grid Padding="10,0,4,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SplitRightButton" Grid.Column="2" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="SplitRight_Click" AutomationProperties.Name="Split pane right" ToolTipService.ToolTip="Split pane right">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitRightButton}">
                        <Rectangle Width="1" Height="10" Fill="{Binding Foreground, ElementName=SplitRightButton}" />
                    </Border>
                </Button>
                <Button x:Name="SplitDownButton" Grid.Column="3" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="SplitDown_Click" AutomationProperties.Name="Split pane down" ToolTipService.ToolTip="Split pane down">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitDownButton}">
                        <Rectangle Width="11" Height="1" Fill="{Binding Foreground, ElementName=SplitDownButton}" />
                    </Border>
                </Button>
                <Button Grid.Column="4" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="Close_Click" AutomationProperties.Name="Close pane" ToolTipService.ToolTip="Close pane">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                </Button>
            </Grid>
            <ContentPresenter x:Name="TerminalContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <Border x:Name="ActiveBorder" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.7" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
