<UserControl
    x:Class="AgentTerm_App.TerminalPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Translation="0,0,4"
    Loaded="Pane_Loaded">
    <UserControl.Shadow><ThemeShadow /></UserControl.Shadow>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="PaneActionIconOpacity">0.5</x:Double>
                    <x:Double x:Key="PaneActiveStrokeOpacity">0.55</x:Double>
                    <SolidColorBrush x:Key="PaneBoundaryBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="PaneGitAddedBrush" Color="#6CCB8D" />
                    <SolidColorBrush x:Key="PaneGitDeletedBrush" Color="#FF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="PaneActionIconOpacity">0.5</x:Double>
                    <x:Double x:Key="PaneActiveStrokeOpacity">0.55</x:Double>
                    <SolidColorBrush x:Key="PaneBoundaryBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="PaneGitAddedBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="PaneGitDeletedBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="PaneActionIconOpacity">1</x:Double>
                    <x:Double x:Key="PaneActiveStrokeOpacity">1</x:Double>
                    <SolidColorBrush x:Key="PaneBoundaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PaneGitAddedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PaneGitDeletedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PaneActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ActionRoot" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActionContent.Opacity" Value="1" />
                                                <Setter Target="ActionRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActionContent.Opacity" Value="1" />
                                                <Setter Target="ActionRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="0.25" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="1" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="1" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" Opacity="{ThemeResource PaneActionIconOpacity}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border x:Name="AcrylicSurface" CornerRadius="10" BorderBrush="{ThemeResource PaneBoundaryBrush}" BorderThickness="1">
            <SystemBackdropElement x:Name="PaneBackdrop" CornerRadius="9" IsHitTestVisible="False" />
        </Border>
        <Border x:Name="SolidSurface" Margin="1" CornerRadius="9" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
        <Grid Margin="1" RowDefinitions="28,*">
            <Grid Padding="10,0,4,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                <Grid x:Name="HeaderContext" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"
                      VerticalAlignment="Center" SizeChanged="HeaderContext_SizeChanged">
                    <Path Width="13" Height="12" Data="M 1,2 L 5,6 L 1,10 M 7,10 L 12,10"
                          Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.4" VerticalAlignment="Center" />
                    <TextBlock x:Name="PaneShell" Grid.Column="1" MaxWidth="110" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                        <TextBlock x:Name="PaneDirectory" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="GitSummary" Grid.Column="1" Orientation="Horizontal" Spacing="6" MaxWidth="280" Visibility="Collapsed">
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Path Data="M 3,3 L 3,9 M 3,7 C 3,4 9,7 9,3" StrokeThickness="1"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,0,0,0"
                                         Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1.5,0,0,0"
                                         Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,1.5,0"
                                         Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" />
                            </Grid>
                            <TextBlock x:Name="GitBranch" MaxWidth="130" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="GitDetails" Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="GitTracking" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GitAdded" FontSize="11" Foreground="{ThemeResource PaneGitAddedBrush}" />
                                <TextBlock x:Name="GitDeleted" FontSize="11" Foreground="{ThemeResource PaneGitDeletedBrush}" />
                                <TextBlock x:Name="GitChanges" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                <ContentControl x:Name="PromptModeHost" Grid.Column="1" VerticalAlignment="Center" />
                <Button x:Name="SplitRightButton" Grid.Column="2" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="SplitRight_Click" AutomationProperties.Name="Split pane right" ToolTipService.ToolTip="Split pane right">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitRightButton}">
                        <Rectangle Width="1" Height="10" Fill="{Binding Foreground, ElementName=SplitRightButton}" />
                    </Border>
                </Button>
                <Button x:Name="SplitDownButton" Grid.Column="3" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="SplitDown_Click" AutomationProperties.Name="Split pane down" ToolTipService.ToolTip="Split pane down">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitDownButton}">
                        <Rectangle Width="11" Height="1" Fill="{Binding Foreground, ElementName=SplitDownButton}" />
                    </Border>
                </Button>
                <Button Grid.Column="4" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="Close_Click" AutomationProperties.Name="Close pane" ToolTipService.ToolTip="Close pane">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                </Button>
            </Grid>
            <ContentPresenter x:Name="TerminalContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <Border x:Name="ActiveBorder" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="{ThemeResource PaneActiveStrokeOpacity}" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
