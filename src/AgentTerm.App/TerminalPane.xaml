<UserControl
    x:Class="AgentTerm_App.TerminalPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Translation="0,0,4"
    Loaded="Pane_Loaded" Unloaded="Pane_Unloaded">
    <UserControl.Shadow><ThemeShadow /></UserControl.Shadow>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="PaneActionIconOpacity">0.5</x:Double>
                    <x:Double x:Key="PaneActiveStrokeOpacity">0.55</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="PaneActionIconOpacity">1</x:Double>
                    <x:Double x:Key="PaneActiveStrokeOpacity">1</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PaneActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ActionRoot" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActionContent.Opacity" Value="1" />
                                                <Setter Target="ActionRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActionContent.Opacity" Value="1" />
                                                <Setter Target="ActionRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="0.25" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="1" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters><Setter Target="ActionContent.Opacity" Value="1" /></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" Opacity="{ThemeResource PaneActionIconOpacity}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border x:Name="SolidSurface" CornerRadius="10" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" />
        <Border x:Name="AcrylicSurface" CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" Visibility="Collapsed">
            <Border.Background>
                <AcrylicBrush x:Name="PaneAcrylicBrush" TintColor="{ThemeResource SystemChromeMediumColor}"
                              FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
            </Border.Background>
        </Border>
        <Grid Margin="1" RowDefinitions="32,*">
            <Grid Padding="10,0,4,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SplitRightButton" Grid.Column="2" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="SplitRight_Click" AutomationProperties.Name="Split pane right" ToolTipService.ToolTip="Split pane right">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitRightButton}">
                        <Rectangle Width="1" Height="10" Fill="{Binding Foreground, ElementName=SplitRightButton}" />
                    </Border>
                </Button>
                <Button x:Name="SplitDownButton" Grid.Column="3" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="SplitDown_Click" AutomationProperties.Name="Split pane down" ToolTipService.ToolTip="Split pane down">
                    <Border Width="13" Height="12" CornerRadius="1" BorderThickness="1" BorderBrush="{Binding Foreground, ElementName=SplitDownButton}">
                        <Rectangle Width="11" Height="1" Fill="{Binding Foreground, ElementName=SplitDownButton}" />
                    </Border>
                </Button>
                <Button Grid.Column="4" Width="28" MinWidth="0" Height="28" Padding="0"
                        Style="{StaticResource PaneActionButtonStyle}"
                        Click="Close_Click" AutomationProperties.Name="Close pane" ToolTipService.ToolTip="Close pane">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                </Button>
            </Grid>
            <ContentPresenter x:Name="TerminalContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <Border x:Name="ActiveBorder" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="{ThemeResource PaneActiveStrokeOpacity}" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
