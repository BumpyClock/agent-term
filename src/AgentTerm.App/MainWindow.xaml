<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentTerm_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="AgentTerm">
    <Grid x:Name="WindowRoot" PreviewKeyDown="WindowRoot_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="PaneSplitterStyle" TargetType="primitives:Thumb">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <TabView x:Name="Tabs" Background="Transparent" VerticalAlignment="Stretch" IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent" CloseButtonOverlayMode="OnPointerOver"
                 SelectionChanged="Tabs_SelectionChanged" TabCloseRequested="Tabs_TabCloseRequested">
            <TabView.TabStripFooter>
                <Grid ColumnDefinitions="Auto,*">
                    <SplitButton Click="NewTabButton_Click" Margin="4,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="New tab" ToolTipService.ToolTip="New tab (Ctrl+Shift+T)">
                        <SymbolIcon Symbol="Add" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="ProfileMenu" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Grid x:Name="TabDragRegion" Grid.Column="1" MinWidth="188" Background="Transparent" />
                </Grid>
            </TabView.TabStripFooter>
        </TabView>
    </Grid>
</Window>
