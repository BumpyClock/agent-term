<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentTerm_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentTerm">
    <Grid x:Name="WindowRoot" PreviewKeyDown="WindowRoot_PreviewKeyDown">
        <Border x:Name="SolidBackdrop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
        <TabView x:Name="Tabs" VerticalAlignment="Stretch" IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent" CloseButtonOverlayMode="OnPointerOver"
                 SelectionChanged="Tabs_SelectionChanged" TabCloseRequested="Tabs_TabCloseRequested">
            <TabView.TabStripFooter>
                <Grid ColumnDefinitions="Auto,*">
                    <SplitButton Click="NewTabButton_Click" Margin="4,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="New tab" ToolTipService.ToolTip="New tab (Ctrl+Shift+T)">
                        <SymbolIcon Symbol="Add" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="ProfileMenu" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Grid x:Name="TabDragRegion" Grid.Column="1" MinWidth="188" Background="Transparent" />
                </Grid>
            </TabView.TabStripFooter>
        </TabView>
    </Grid>
</Window>
