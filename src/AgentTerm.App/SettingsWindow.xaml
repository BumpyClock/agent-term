<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentTerm_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentTerm Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False"
                    AlwaysShowHeader="False" SelectionChanged="SettingsNavigation_SelectionChanged"
                    AutomationProperties.Name="Settings pages">
        <NavigationView.Resources>
            <Style x:Key="SettingCard" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingDescription" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="StartupItem" Content="Startup">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="TabsItem" Content="Tabs">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE737;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Profiles" />
            <NavigationViewItem x:Name="DefaultsItem" Content="Defaults">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Font" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Border Margin="4,8,8,8" CornerRadius="10" BorderThickness="1" Translation="0,0,8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Border.Shadow><ThemeShadow /></Border.Shadow>
        <Grid RowDefinitions="*,Auto">
            <ScrollViewer x:Name="DetailScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch">
                    <InfoBar x:Name="SettingsNotice" IsClosable="True" />
                    <StackPanel x:Name="StartupPage" Spacing="20">
                        <TextBlock Text="Startup" FontSize="26" FontWeight="SemiBold" />
                        <Border Style="{StaticResource SettingCard}">
                            <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Default profile" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Shell used at startup and when you open a new tab."
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="DefaultProfileBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          AutomationProperties.Name="Default profile" SelectionChanged="DraftChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Terminal start position" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Start the shell prompt at the top or bottom. Applies to all panes when saved."
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="TerminalStartPositionBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          AutomationProperties.Name="Terminal start position" SelectionChanged="DraftChanged">
                                    <ComboBoxItem Content="Bottom" />
                                    <ComboBoxItem Content="Top" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="TabsPage" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Tabs" FontSize="26" FontWeight="SemiBold" />
                        <Border Style="{StaticResource SettingCard}">
                            <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Tab position" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Show tabs above the panes or in a sidebar. Open tabs and panes keep running when you switch."
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="TabPositionBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          AutomationProperties.Name="Tab position" SelectionChanged="DraftChanged">
                                    <ComboBoxItem Content="Top" />
                                    <ComboBoxItem Content="Left" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="DefaultsPage" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Profile defaults" FontSize="26" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Color scheme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Auto follows Windows. Light and Dark use their selected themes." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ColorSchemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Default color scheme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Light theme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Colors used in light mode." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LightThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Default light theme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Dark theme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Colors used in dark mode." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DarkThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Default dark theme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Font family" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Default typeface, inherited by profiles unless they override it."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="FontFamilyBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Font family" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Font size" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Default terminal text size. Enter a whole number from 8 to 36."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <TextBox x:Name="FontSizeBox" Grid.Column="1" VerticalAlignment="Center"
                                             AutomationProperties.Name="Font size" TextChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Pane background" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Default surface for terminal panes."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="BackgroundBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Default pane background" SelectionChanged="DraftChanged">
                                        <ComboBoxItem Content="Solid" />
                                        <ComboBoxItem Content="Acrylic" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Background opacity" Style="{StaticResource SettingLabel}" />
                                        <TextBlock x:Name="OpacityDescription" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" />
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" StepFrequency="1"
                                                ValueChanged="OpacityChanged" AutomationProperties.Name="Default background opacity"
                                                AutomationProperties.HelpText="Acrylic background opacity in percent. Terminal text stays opaque." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ProfilePage" Spacing="20" Visibility="Collapsed">
                        <TextBlock x:Name="ProfileTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Reset to defaults" Click="ResetProfile_Click" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Color scheme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Use the default or choose this profile's color scheme." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ProfileColorSchemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Profile color scheme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Light theme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Use the default or choose this profile's light theme." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ProfileLightThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Profile light theme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Dark theme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Use the default or choose this profile's dark theme." Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ProfileDarkThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Profile dark theme" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Font family" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Inherit Defaults or choose a typeface for this profile."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ProfileFontFamilyBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Profile font family" SelectionChanged="DraftChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Font size" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Use the default size or enter a whole number from 8 to 36."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <CheckBox x:Name="ProfileInheritSize" Content="Use default" Checked="DraftChanged" Unchecked="DraftChanged"
                                                  AutomationProperties.Name="Use default font size" />
                                        <TextBox x:Name="ProfileFontSizeBox" AutomationProperties.Name="Profile font size" TextChanged="DraftChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Pane background" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Inherit Defaults or choose this profile's surface."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ProfileBackgroundBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              AutomationProperties.Name="Profile pane background" SelectionChanged="DraftChanged">
                                        <ComboBoxItem Content="Use default" />
                                        <ComboBoxItem Content="Solid" />
                                        <ComboBoxItem Content="Acrylic" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <Grid ColumnDefinitions="*,236" ColumnSpacing="24">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Background opacity" Style="{StaticResource SettingLabel}" />
                                        <TextBlock x:Name="ProfileOpacityDescription" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <CheckBox x:Name="ProfileInheritOpacity" Content="Use default" Checked="DraftChanged" Unchecked="DraftChanged"
                                                  AutomationProperties.Name="Use default background opacity" />
                                        <TextBlock x:Name="ProfileOpacityValue" HorizontalAlignment="Right" />
                                        <Slider x:Name="ProfileOpacitySlider" Minimum="0" Maximum="100" StepFrequency="1"
                                                ValueChanged="OpacityChanged" AutomationProperties.Name="Profile background opacity"
                                                AutomationProperties.HelpText="Acrylic background opacity in percent. Terminal text stays opaque." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Height="66" Padding="24,12" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="DiscardButton" Grid.Column="1" Content="Discard changes" VerticalAlignment="Center"
                            Click="Discard_Click" IsEnabled="False" />
                    <Button x:Name="SaveButton" Grid.Column="2" Content="Save" VerticalAlignment="Center" MinWidth="80"
                            Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>
        </Border>
    </NavigationView>
</Window>
